{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/create-order.js": { "maxDuration": 20 },
    "api/verify-payment.js": { "maxDuration": 60 },
    "api/order-status.js": { "maxDuration": 20 },
    "api/reviews.js": { "maxDuration": 30 },
    "api/test-whatsapp-alert.js": { "maxDuration": 20 }
  },
  "rewrites": [
    { "source": "/admin", "destination": "/admin/index.html" },
    { "source": "/product/:slug", "destination": "/product/index.html?slug=:slug" },
    { "source": "/products/:slug", "destination": "/product/index.html?slug=:slug" },
    { "source": "/thank-you", "destination": "/thank-you.html" }
  ]
}
